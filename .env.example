# Backend settings (all optional; defaults shown)
PROVIDER_TIMEZONE=UTC          # IANA zone name; an unknown name aborts startup
JWT_LIFETIME_MINUTES=30        # access token lifetime
DATABASE_PATH=./telemed.db     # SQLite file (also used by `alembic upgrade head`)
BUSY_TIMEOUT_MS=10000          # SQLite busy timeout, minimum 5000
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789  # HS256 key, >= 32 bytes; set a real secret outside dev
VIDEO_BASE_URL=https://video.example.test/visit  # stub video join URL base
